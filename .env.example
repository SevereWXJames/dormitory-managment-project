# Backend environment variables
# Copy this file to .env before running the backend
MONGODB_URL_DEFAULT=mongodb://localhost:27017
MONGO_URI=mongodb://mongo:27017/smartapt
FRONT_END_URL=http://localhost:5173
ACCESS_TOKEN_SECRET=team-07-your-access-token-secret
REFRESH_TOKEN_SECRET=team-07-your-refresh-token-secret
BACKEND_PORT=5000
SAMPLE_PASSWORD=pass.word
COMPOSE_PROFILES=production
LOAD_SAMPLE_DATA=true
SLOT_RESET_HOUR=2
SLOT_RESET_DAYS_AHEAD=7
NODE_ENV=production # for testing purposes
MQTT_URI= mqtt://mosquitto:1883/ #local: mqtt://localhost:1883/ #docker: mqtt://mosquitto:1883/
